{
  "name": "@webship.co/workspace-mediawiki",
  "version": "1.0.0",
  "description": "MediaWiki for Webship Workspace: the builder (`cmd-mediawiki-project.sh`, the release tarball installed by its own installer, with the visual editor on request) and the maintenance tool in every sites folder, the default accounts, the MediaWiki step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-mediawiki.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "mediawiki",
    "label": "MediaWiki",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-mediawiki-project.sh",
        "commands/cmd-tools-mediawiki-maintenance.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-mediawiki.sh"
      ],
      "args": [
        "scripts/args/arg-mediawiki.sh",
        "scripts/args/arg-mediawiki-maintenance.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/mediawiki-site-builder.md",
        "ai/agents/mediawiki-tester.md"
      ],
      "skills": [
        "ai/skills/mediawiki-scenarios"
      ],
      "commands": [
        "ai/commands/mediawiki-test.md"
      ],
      "prompts": [
        "ai/prompts/mediawiki-build-and-test.md",
        "ai/prompts/mediawiki-scenarios-for-an-area.md"
      ]
    },
    "features": [
      "features/mediawiki.feature",
      "features/mediawiki-runtimes.feature"
    ],
    "featuresSite": "cmd-mediawiki-project.sh ci-mediawiki --install --add-users --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
